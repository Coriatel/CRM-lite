#!/usr/bin/env node
// secrets-apply — the root side of the "type it once, it is applied everywhere"
// pipeline. A systemd .path unit triggers this when merkaz-secrets drops a
// marker in the apply queue after the owner saves a value. For each target the
// marker names, run `secretsctl rotate <target> --from-vault`, then write the
// outcome back where the owner-facing app can show it.
//
// Rules, because this runs as root and touches live services:
//   - a value is never read here, never logged, never written to the status
//     file. The marker carries ids only; secretsctl handles the value and logs
//     nothing but names and version digests. This script logs the same.
//   - the marker is removed after it is processed, so the .path unit re-arms;
//     the outcome lives in the status file, and a retry is a re-save by the
//     owner. A container recreate is surfaced as an owner command, never run.
//   - the marker is written by the web app's account, so nothing in it is
//     trusted: it must be a small regular file (never followed through a
//     symlink), request_id and every target must be plain ids, and a bad
//     marker is logged without its content.
//   - the queue and status directories belong to that account, so root never
//     writes, renames or deletes by a path inside them: the status file and
//     the marker removal run AS the app account. A symlink or directory
//     swapped in there then reaches only what the app could reach anyway (a
//     recursive delete as root, raced against a swapped-in symlink, deletes
//     elsewhere; a status rename as root through a symlinked status dir
//     overwrites any *.json).

import { execFileSync } from "node:child_process";
import { closeSync, constants, fstatSync, openSync, readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { userInfo } from "node:os";

const QUEUE = process.env.MS_APPLY_QUEUE_DIR || "/var/lib/merkaz-secrets/apply-queue";
const STATUS = process.env.MS_APPLY_STATUS_DIR || "/var/lib/merkaz-secrets/apply-status";
const SECRETSCTL = process.env.SECRETSCTL || "/opt/crm-secrets/current/crm-app/scripts/secrets/secretsctl.mjs";
const STORE_ROOT = process.env.SECRET_STORE_ROOT || "/var/lib/crm-secrets";
const KEY_FILE = process.env.SECRET_KEY_FILE || "/etc/crm-secrets/secretsd.key";
// The app identity that owns the queue and reads the status file. Overridable
// only through the unit's environment (the adversarial test uses its own user).
const OWNER_USER = process.env.MS_APPLY_APP_USER || "crmsecrets";
const ID_RE = /^[A-Za-z0-9_-]{1,64}$/;
const TARGET_RE = /^[a-z][a-z0-9_]{0,63}$/;
const MAX_MARKER = 4096;

function log(...a) {
  console.log(new Date().toISOString(), ...a);
}

function ownerIds() {
  try {
    const line = readFileSync("/etc/passwd", "utf8").split("\n").find((l) => l.startsWith(OWNER_USER + ":"));
    const p = line.split(":");
    return { uid: Number(p[2]), gid: Number(p[3]) };
  } catch {
    return null;
  }
}

// Run a small node program AS the app account (libuv also drops root's
// supplementary groups). Throws if the account is missing or the program fails.
function asApp(code, args, input = "") {
  const o = ownerIds();
  if (!o) throw new Error(`${OWNER_USER} account missing`);
  execFileSync(process.execPath, ["-e", code, "--", ...args], { uid: o.uid, gid: o.gid, input, env: {}, stdio: ["pipe", "ignore", "ignore"], timeout: 30_000 });
}

const WRITE_STATUS = `
const fs = require("fs");
const [dir, name] = process.argv.slice(1);
fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
const tmp = dir + "/" + name + ".tmp." + process.pid;
fs.writeFileSync(tmp, fs.readFileSync(0), { flag: "wx", mode: 0o640 });
fs.renameSync(tmp, dir + "/" + name);
`;
const REMOVE = `require("fs").rmSync(process.argv[1], { recursive: true, force: true });`;

function writeStatus(id, obj) {
  try {
    asApp(WRITE_STATUS, [STATUS, `${id}.json`], JSON.stringify(obj, null, 2));
  } catch {
    log("status for", id, "could not be written");
  }
}

function removeMarker(path) {
  try {
    asApp(REMOVE, [path]);
  } catch {
    log("a marker could not be removed; the next run sees it again");
  }
}

// A marker is read only if it is a small regular file; a symlink fails the
// open (O_NOFOLLOW). Returns the parsed object, or null for a bad marker.
function readMarker(path) {
  let fd;
  try {
    fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
    const st = fstatSync(fd);
    if (!st.isFile() || st.size > MAX_MARKER) return null;
    const m = JSON.parse(readFileSync(fd, "utf8"));
    if (!m || typeof m !== "object" || !ID_RE.test(String(m.request_id)) || !Array.isArray(m.targets)) return null;
    return m;
  } catch {
    return null;
  } finally {
    if (fd !== undefined) closeSync(fd);
  }
}

function runRotate(target) {
  // Never put a value on argv; --from-vault reads it from the store. stdout is
  // value-free by secretsctl's design, so it is safe to capture and surface.
  const out = execFileSync("node", [SECRETSCTL, "rotate", "--secret", target, "--from-vault"], {
    encoding: "utf8",
    env: { ...process.env, SECRET_STORE_ROOT: STORE_ROOT, SECRET_KEY_FILE: KEY_FILE },
    stdio: ["ignore", "pipe", "pipe"],
  });
  return out;
}

function main() {
  if (userInfo().uid !== 0) {
    log("refusing to run as non-root");
    process.exit(2);
  }
  let markers;
  try {
    markers = readdirSync(QUEUE).filter((f) => f.endsWith(".json") && !f.includes(".tmp."));
  } catch {
    return; // queue dir absent: nothing to do
  }
  for (const f of markers) {
    const path = join(QUEUE, f);
    const marker = readMarker(path);
    if (!marker) {
      // No content in the log: the file may be anything the app account
      // could point at.
      log("bad marker, removing", ID_RE.test(f.slice(0, -5)) ? f : "(unprintable name)");
      removeMarker(path);
      continue;
    }
    const id = marker.request_id;
    const targets = marker.targets.map(String);
    log("processing", id, "targets", targets.filter((t) => TARGET_RE.test(t)).join(","));
    const results = [];
    const ownerCommands = [];
    let ok = true;
    for (const t of targets) {
      if (!TARGET_RE.test(t)) {
        ok = false;
        results.push({ target: "(invalid)", ok: false, detail: "bad target id" });
        log("  rejected a malformed target id");
        continue;
      }
      try {
        const out = runRotate(t);
        for (const line of out.split("\n")) if (/^\s*!\s/.test(line)) ownerCommands.push(line.trim());
        results.push({ target: t, ok: true });
        log("  rotated", t, "ok");
      } catch (e) {
        ok = false;
        // stderr is value-free (secretsctl builds errors from names only).
        const detail = String(e.stderr || e.message || "").split("\n").filter(Boolean).slice(-1)[0] || "failed";
        results.push({ target: t, ok: false, detail: detail.slice(0, 200) });
        log("  rotate FAILED", t, detail.slice(0, 200));
      }
    }
    writeStatus(id, {
      state: ok ? "applied" : "apply_failed",
      at: new Date().toISOString(),
      targets: results,
      owner_commands: [...new Set(ownerCommands)],
      detail: ok ? (ownerCommands.length ? "חלק מהשירותים דורשים הפעלה מחדש על ידי הבעלים" : "הוחל ואומת") : "ראה פירוט",
    });
    // Processed: remove the marker so the .path unit re-arms. The outcome is in
    // the status file; a retry is a fresh save by the owner.
    removeMarker(path);
    log("done", id, ok ? "applied" : "apply_failed");
  }
}

main();
