[Unit]
Description=watch the merkaz-secrets apply queue and trigger secrets-apply
Documentation=https://claude.ai/code/session_01TrSUfSNz7JQjrjhqmGRFDi

[Path]
# Fires secrets-apply.service whenever a marker is present. The service drains
# the queue and removes each marker, so the watch re-arms on its own.
PathExistsGlob=/var/lib/merkaz-secrets/apply-queue/*.json
Unit=secrets-apply.service

[Install]
WantedBy=multi-user.target
