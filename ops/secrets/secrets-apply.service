[Unit]
Description=secrets-apply — apply owner-saved secret values to their targets
Documentation=https://claude.ai/code/session_01TrSUfSNz7JQjrjhqmGRFDi
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
# Root: the targets span a Postgres role inside a container, env files owned by
# several accounts, a pm2 process under devuserp, and a Windmill variable.
User=root
Environment=SECRET_STORE_ROOT=/var/lib/crm-secrets
Environment=SECRET_KEY_FILE=/etc/crm-secrets/secretsd.key
Environment=MS_APPLY_QUEUE_DIR=/var/lib/merkaz-secrets/apply-queue
Environment=MS_APPLY_STATUS_DIR=/var/lib/merkaz-secrets/apply-status
ExecStart=/usr/local/sbin/secrets-apply
# A value never reaches the journal; the script logs names and digests only.
