[Unit]
Description=secretsd — owner-authenticated secret backend (loopback only)
After=network.target

[Service]
Type=simple

# Dedicated identity. This is the whole point of the unit: the store and the
# encryption key are readable ONLY by crmsecrets. The interactive work accounts
# (devuserp, devuser, elron, and any Claude or Codex session running as them)
# are not this user and cannot read a value, with or without the API.
User=crmsecrets
Group=crmsecrets

# Canonical runtime path. A symlink flipped by the release script, so a
# rollback is one symlink swap and never a git checkout in a live directory.
WorkingDirectory=/opt/crm-secrets/current/crm-app/scripts/secrets
ExecStart=/usr/bin/node /opt/crm-secrets/current/crm-app/scripts/secrets/secretsd.mjs
EnvironmentFile=/etc/crm-secrets/secretsd.env

Restart=on-failure
RestartSec=3
# A key that is missing or malformed exits 3 and must NOT be retried forever:
# restart-looping on a broken key just fills the journal.
RestartPreventExitStatus=2 3

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

# The only writable path. Everything else is read-only to this service.
ReadWritePaths=/var/lib/crm-secrets

# Loopback only. Even a misconfigured reverse proxy cannot make this public.
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any

# NOTE: MemoryDenyWriteExecute is deliberately NOT set. It is incompatible with
# V8's JIT and crashes node with status=5/TRAP. This was learned the hard way
# during the P1 activation; do not "harden" it back in.

[Install]
WantedBy=multi-user.target
