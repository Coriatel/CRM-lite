#!/usr/bin/env node
// secrets-materialize — deploy ONE registered secret to ONE fixed allowlisted target.
//
// What this is NOT, deliberately:
//   There is no verb here that prints, returns, echoes, derives, truncates or
//   hashes a secret value. The caller names a DEPLOYMENT ID, never a secret and
//   never a path. It cannot reach a secret the owner did not expose, and cannot
//   widen its own reach by guessing names. Same rule as secretbroker.mjs.
//
// The value exists only in this process's memory, between readSecretValue() and
// the write() into an already-0600 file. It never becomes an argv entry, an env
// var, a log line, an audit field, or a world-readable temp file.
//
// Root is required for exactly one reason: the target must be root:aisecrets
// 0640 inside a root-owned directory. Nothing else here needs privilege.

import { execFileSync } from "node:child_process";
import {
  appendFileSync, chmodSync, chownSync, closeSync, fsyncSync, lstatSync,
  openSync, readFileSync, renameSync, unlinkSync, writeSync,
} from "node:fs";
import { dirname, join } from "node:path";

const STORE_ROOT = process.env.SECRET_STORE_ROOT || "/var/lib/crm-secrets";
const APP = process.env.SECRETS_APP_DIR
  || "/opt/crm-secrets/current/crm-app/scripts/secrets";
const ALLOWLIST = process.env.DEPLOY_TARGETS_FILE || join(STORE_ROOT, "deploy-targets.json");

// Every destination must live under this prefix. A second directory is a
// deliberate review, not a config edit.
const ALLOWED_DIR = "/etc/ai-secrets/";
const ALLOWED_MODES = new Set(["0600", "0640"]);
const MAX_ALLOWLIST_BYTES = 1_000_000;

function die(msg) {
  process.stderr.write(`secrets-materialize: ${msg}\n`);
  process.exit(1);
}

// ---------------------------------------------------------------- allowlist
// Read as root, and refuse it unless root alone can write it. An allowlist a
// consumer can edit is not an allowlist.
function loadAllowlist() {
  const st = lstatSync(ALLOWLIST, { throwIfNoEntry: false });
  if (!st) die(`allowlist not found: ${ALLOWLIST}`);
  if (st.isSymbolicLink()) die("allowlist is a symlink — refusing");
  if (!st.isFile()) die("allowlist is not a regular file — refusing");
  if (st.size > MAX_ALLOWLIST_BYTES) die("allowlist is implausibly large — refusing");
  if (st.uid !== 0 || st.gid !== 0) die("allowlist must be owned root:root — refusing");
  if ((st.mode & 0o077) !== 0) die("allowlist must not be group/other accessible — refusing");

  let parsed;
  try {
    parsed = JSON.parse(readFileSync(ALLOWLIST, "utf8"));
  } catch {
    die("allowlist is not valid JSON — refusing");
  }
  const list = Array.isArray(parsed?.targets) ? parsed.targets : null;
  if (!list) die("allowlist has no targets[] — refusing");
  return list;
}

const FIELDS = ["id", "secret", "consumer", "path", "env_var", "owner", "group", "mode"];

function validateTarget(t) {
  for (const f of FIELDS) {
    if (typeof t[f] !== "string" || t[f] === "") die(`target entry missing field: ${f}`);
  }
  for (const k of Object.keys(t)) {
    if (!FIELDS.includes(k)) die(`target entry has unknown field: ${k}`);
  }
  // Destination: literal, absolute, inside ALLOWED_DIR, single path segment.
  const p = t.path;
  if (!p.startsWith(ALLOWED_DIR)) die(`destination outside ${ALLOWED_DIR}: refusing`);
  if (p.includes("..") || p.includes("//")) die("destination has traversal — refusing");
  const leaf = p.slice(ALLOWED_DIR.length);
  if (leaf === "" || leaf.includes("/")) die("destination must be a direct child — refusing");
  if (!/^[A-Za-z0-9._-]+$/.test(leaf)) die("destination filename has unexpected characters");
  if (!ALLOWED_MODES.has(t.mode)) die(`mode ${t.mode} not permitted`);
  if (t.owner !== "root") die("target owner must be root");
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(t.env_var)) die("env_var is not a valid shell identifier");
  return t;
}

function gidFor(group) {
  const line = readFileSync("/etc/group", "utf8")
    .split("\n").find((l) => l.startsWith(`${group}:`));
  if (!line) die(`group does not exist: ${group}`);
  return Number(line.split(":")[2]);
}

// ------------------------------------------------------------------- audit
// Same file and same one-object-per-line shape as secretaudit.mjs. The
// operation is a fixed literal in this file, never caller input, so the
// "unknown operation" guard there has nothing to defend against here.
function audit(rec) {
  try {
    const path = join(STORE_ROOT, "audit.log");
    const scrub = (v) => (v == null ? null : String(v).replace(/[\r\n]+/g, " ").slice(0, 200));
    appendFileSync(path, `${JSON.stringify({
      ts: new Date().toISOString(),
      actor: scrub(rec.actor),
      operation: "materialize",
      secret: scrub(rec.secret),
      outcome: scrub(rec.outcome),
      reason: scrub(rec.reason),
    })}\n`, { mode: 0o600 });
  } catch {
    // Best-effort, exactly as secretaudit.mjs: an audit failure must never turn
    // an already-committed write into a reported failure.
  }
}

function actor() {
  const s = process.env.SUDO_USER;
  return s ? `${s} (via sudo)` : `uid:${process.getuid()}`;
}

// ------------------------------------------------------------------- write
// Never write in place. A fresh inode is renamed over the name, so any external
// hardlink keeps pointing at the untouched old inode.
function writeTargetAtomic(dest, contents, uid, gid, mode) {
  const dir = dirname(dest);
  const tmp = join(dir, `.tmp-materialize-${process.pid}`);
  let fd;
  try {
    // 0600 from the instant it exists — never briefly group- or world-readable.
    fd = openSync(tmp, "wx", 0o600);
    writeSync(fd, contents);
    fsyncSync(fd);
  } finally {
    if (fd !== undefined) closeSync(fd);
  }
  try {
    chownSync(tmp, uid, gid);
    chmodSync(tmp, mode);       // restate: openSync's mode is masked by umask
    renameSync(tmp, dest);
  } catch (e) {
    try { unlinkSync(tmp); } catch { /* nothing to clean */ }
    throw e;
  }
  let dfd;
  try { dfd = openSync(dir, "r"); fsyncSync(dfd); } catch { /* durability best-effort */ }
  finally { if (dfd !== undefined) closeSync(dfd); }
}

// -------------------------------------------------------------------- main
const id = process.argv[2];
if (!id || process.argv.length > 3) {
  process.stderr.write("usage: secrets-materialize <deployment-id>\n");
  process.exit(2);
}
if (process.getuid() !== 0) die("must run as root");

const target = validateTarget(
  loadAllowlist().find((t) => t?.id === id)
    || die(`no such deployment id: ${id}`),
);

const { readSecretValue } = await import(join(APP, "secretstore.mjs"));
const { assertSafeTargetFile } = await import(join(APP, "secretstore.mjs"));

let value;
try {
  value = readSecretValue(target.secret);
} catch (e) {
  // e.message may name the secret; it never contains the value.
  audit({ actor: actor(), secret: target.secret, outcome: "failure", reason: "read failed" });
  die(`could not read secret ${target.secret}: ${e.message}`);
}
if (typeof value !== "string" || value.length === 0) {
  audit({ actor: actor(), secret: target.secret, outcome: "failure", reason: "empty value" });
  die(`secret ${target.secret} is empty — refusing to deploy`);
}

assertSafeTargetFile(target.path);
const mode = parseInt(target.mode, 8);
const gid = gidFor(target.group);

try {
  writeTargetAtomic(target.path, `${target.env_var}=${value}\n`, 0, gid, mode);
} catch (e) {
  audit({ actor: actor(), secret: target.secret, outcome: "failure", reason: "write failed" });
  die(`write failed for ${target.path}: ${e.message}`);
}

audit({
  actor: actor(), secret: target.secret, outcome: "success",
  reason: `${target.consumer} -> ${target.path} ${target.mode} ${target.owner}:${target.group}`,
});

// Status only. Not the value, not its length, not a prefix, not a fingerprint.
process.stdout.write(
  `materialized: ${id} (secret ${target.secret}, consumer ${target.consumer}) `
  + `-> ${target.path} [${target.mode} ${target.owner}:${target.group}, 1 variable]\n`,
);
